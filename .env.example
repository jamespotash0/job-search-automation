# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# ONLY EMAIL_USER / EMAIL_PASS / EMAIL_TO are required. Everything else in this
# file is optional and already has a sensible default — a `.env` with three
# lines in it runs the whole system. The long tuning section at the bottom is
# there for when you want to change something, not a checklist to fill in.
# `.env` is gitignored — your real values never get committed.
# For scheduled runs on GitHub Actions, add these same keys as repo secrets
# (Settings → Secrets and variables → Actions), not in this file.

# --- Email (required to receive digests) ---------------------------------
# Uses Gmail SMTP by default. EMAIL_PASS must be a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal login password. Enter it with no spaces (16 chars).
EMAIL_USER=you@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_TO=you@gmail.com          # where digests go; can equal EMAIL_USER, or a comma-separated list

# Digests arrive as "Job Bot (@Name)" so they don't look like mail from yourself.
# The handle defaults to the first name in EMAIL_USER; override it here.
# DIGEST_HANDLE=YourName

# Using a non-Gmail provider? Uncomment and set these:
# SMTP_HOST=smtp.office365.com   # e.g. Outlook
# SMTP_PORT=587

# --- AI summaries (optional) ---------------------------------------------
# From console.anthropic.com. Without it, the funding digest skips the
# AI company summaries; everything else still works. Costs a few cents/day.
ANTHROPIC_API_KEY=

# --- Verified founder emails (optional) ----------------------------------
# From hunter.io (free tier ~50/mo). Without it, contact emails are
# pattern-guessed and marked UNVERIFIED.
HUNTER_API_KEY=

# --- Hiring posts from X/Twitter (optional) ------------------------------
# From console.x.ai. Turns on the X/Grok source in the companies digest:
# founder "we're hiring" posts that never hit a job board. Uses xAI's Agent
# Tools API (x_search); ~half a cent per run, so cents/month. Either name works.
GROK_API_KEY=
# XAI_API_KEY=                    # alias — set one or the other, not both

# --- Extra job aggregator (optional) -------------------------------------
# Free app id + key from developer.adzuna.com. Broadens the companies digest
# beyond the ATS watchlist (indexes many boards + company career pages).
# Both must be set or the source stays off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Compiled profile for scheduled runs (GitHub Actions only) -----------
# NOT used locally (the scripts read profile.compiled.json from disk). For your
# fork's Actions runs, add the CONTENTS of your profile.compiled.json as the
# repo secret PROFILE_COMPILED_JSON, so the digests use your resume-tuned
# filters instead of the generic defaults. Regenerate with: python setup_profile.py

# ==========================================================================
# TUNING — every setting below is OPTIONAL
# ==========================================================================
# Skip this whole section on your first run. Nothing here is required: every
# line is commented out, and a commented-out line means the built-in default
# applies — the same default the repo runs on today. Come back when a digest is
# showing you the wrong things. Precedence is: code default < profile.compiled.json < this file, so
# anything you set here wins for that run. Lists are comma-separated and an
# EMPTY value means an empty list (JOB_SECONDARY_LOCATIONS= turns that tier off,
# it does not fall back to the default). Booleans take 1/true/yes/on or
# 0/false/no/off. For GitHub Actions, set these as repo variables/secrets.

# --- Who you are (normally comes from profile.compiled.json) -------------
# Quick overrides for a single run, without recompiling your profile.
# JOB_TARGET_TITLES=product manager,associate product manager
# JOB_SKILLS=roadmap,sql,figma,prd
# JOB_DOMAINS=ai,workflow,fintech
# JOB_YEARS=3

# --- Geography tiers ------------------------------------------------------
# The digests focus on NYC and keep SF/Bay as a ranked-lower second choice.
# JOB_PRIMARY_LOCATIONS=new york,nyc,brooklyn,manhattan
# JOB_SECONDARY_LOCATIONS=san francisco,sf,bay area,palo alto
# JOB_REQUIRE_LOCATION=0          # 1 = drop anything outside the tiers above
# JOB_ALLOW_US_REMOTE=0           # strict NYC/SF on-site only
# JOB_ALLOW_US_ONSITE=0           # drop on-site roles outside NYC/SF entirely
#                                 # (default keeps them, ranked last)
# JOB_REMOTE_OK=1                 # enable the global remote boards (Remotive/Arbeitnow)

# --- Which job sources run ------------------------------------------------
# Each is on by default; the two key-gated ones also need their keys above.
# JOB_USE_REMOTIVE=0
# JOB_USE_ARBEITNOW=0
# JOB_USE_HN=0                    # HN "Who is hiring" thread
# JOB_USE_WORKDAY=0
# JOB_USE_MUSE=0
# JOB_USE_ADZUNA=0
# JOB_USE_GROK_X=0
# JOB_SEARCH_QUERIES=product manager,forward deployed engineer
# JOB_REMOTIVE_QUERIES=product manager,product operations
# XAI_MODEL=grok-4.5              # model for the X/Grok source
# XAI_LOOKBACK_DAYS=5             # how far back the X search looks

# --- Title gates (what gets thrown away before scoring) -------------------
# JOB_SENIORITY_EXCLUDE=senior,staff,principal,director,vp
# JOB_SWE_EXCLUDE=software engineer,backend,frontend
# JOB_OFF_LANE_EXCLUDE=investor,banker,recruiter
# JOB_JUNIOR_SIGNALS=2+ years,associate,early career
# JOB_SENIOR_SIGNALS=5+ years,8+ years,minimum of 5

# --- Scoring weights (the ranking itself) --------------------------------
# Penalties are positive numbers and always subtract.
# JOB_TITLE_POINTS=12             # per target-title hit
# JOB_TITLE_MAX=40                # cap on title points
# JOB_SENIORITY_FIT_POINTS=20     # JD asks for your years
# JOB_TOO_SENIOR_PENALTY=25       # JD asks for far more
# JOB_SKILL_POINTS=3              # per resume-skill hit
# JOB_SKILL_MAX=24
# JOB_DOMAIN_POINTS=2             # per domain hit
# JOB_DOMAIN_MAX=12
# JOB_EARLY_STAGE_POINTS=6        # JD/company is seed–Series B
# JOB_EARLY_STAGE_SOFT_POINTS=3   # startup language, no round named
# JOB_EARLY_STAGE_SOFT_MIN=2      # soft tells needed before that applies
# JOB_LATE_STAGE_PENALTY=6
# JOB_EARLY_ROUNDS=pre-seed,seed,series a,series b
# JOB_NEUTRAL_ROUNDS=series c     # known round, worth 0
# JOB_LATE_ROUNDS=series d,series e,ipo,public,acquired
# JOB_LOC_BONUS_PRIMARY=10        # NYC (or whatever JOB_PRIMARY_LOCATIONS says)
# JOB_LOC_BONUS_REMOTE=5          # US-remote
# JOB_LOC_BONUS_SECONDARY=4       # SF/Bay
# JOB_LOC_BONUS_OTHER=1           # on-site elsewhere in the US
# JOB_PREFER_LARGER=1             # rank bigger companies higher (default: smaller)

# --- Email shape and freshness -------------------------------------------
# JOB_BEST_MATCH_MIN=40           # score cutoff between the email's two sections
# JOB_MAX_ITEMS=30                # cap on "Best matches"
# JOB_MAX_ITEMS_REST=15           # cap on the quieter "Worth a look" section
# JOB_MAX_AGE_DAYS=21             # drop postings older than this (0 = no age gate)
# JOB_SEEN_TTL_DAYS=14            # how long a posting counts as already-sent
# SEND_WHEN_EMPTY=1               # email even when a run finds nothing new

# --- Fetch budget (speed vs coverage) ------------------------------------
# BOARD_WORKERS=8                 # concurrent ATS board fetches
# BOARD_MAX_DETAIL=25             # per-board cap on job-description fetches
# WORKDAY_MAX_DETAIL=25           # same, for Workday boards
# JOB_JD_CHARS=8000               # how much of each JD is kept for scoring
# GETRO_SCAN=400                  # VC-board ids probed per getro.py run
# GETRO_NETWORKS="1200 803"       # always sweep these networks (your funds)
# GETRO_WORKERS=10
# GETRO_PAGES=4                   # pages (100 jobs each) per network
# GETRO_SCAN_MAX_ID=4200          # highest Getro network id worth probing
# WATCHLIST_WORKERS=10

# --- Funding digest -------------------------------------------------------
# FUNDING_FOCUS_KEYWORDS=ai,agent,b2b,saas,workflow
# FUNDING_LOCATIONS=new york,nyc,brooklyn,manhattan
# FUNDING_SECONDARY_LOCATIONS=san francisco,bay area
# FUNDING_FOCUS_POINTS=2          # per focus term in the headline
# FUNDING_LOC_POINTS=3            # per primary-location term
# FUNDING_LOC2_POINTS=2           # per secondary-metro term
# FUNDING_ROUND_POINTS=1          # names a round at all
# FUNDING_BEST_SCORE=6            # cutoff for the "Best matches" section
# FUNDING_MAX_ITEMS=40
# FUNDING_LOOKBACK_HOURS=28       # match your cron: daily run = ~28h
# FUNDING_ENRICH_TOP_N=8          # AI research: unset = every raise, 0 = off
# GEO_MODE=any                    # "us" (default) = US-headquartered only
# SUBSTACK_LOOKBACK_DAYS=14
# SUBSTACK_MAX=6

# --- Enrichment (AI summaries + founder emails) --------------------------
# AI_MODEL=claude-haiku-4-5-20251001
# SETUP_MODEL=claude-sonnet-5     # model setup_profile.py uses to read your resume
# ENRICH_TOP_N=8                  # companies enriched per run
# HUNTER_MONTHLY_CAP=50           # stay inside the free tier

# --- Funded-company loop --------------------------------------------------
# Postings at companies the funding digest saw raise recently get a rocket badge
# and a ranking bonus. Companies with no public ATS board on announcement day
# are re-probed for a while afterward, since boards usually appear weeks later.
# JOB_FUNDED_BONUS=8              # score bonus for a recently-funded company
# WATCHLIST_FUNDED_DAYS=180       # how long a raise keeps flagging its postings
# WATCHLIST_PENDING_DAYS=75       # how long a board-less company stays re-probed
# WATCHLIST_PENDING_TRIES=12      # max re-probes per company
# WATCHLIST_REPROBE_MAX=40        # max companies re-probed per run

# --- Company discovery (discover.py) -------------------------------------
# DISCOVER_MAX=30                 # companies added per run
# DISCOVER_ANGLES=hiring,funded   # which web-search sweeps to run
# DISCOVER_SECONDARY_LOCATIONS=san francisco,bay area
# DISCOVER_MODEL=claude-sonnet-5

# --- Experience-bar filter (optional) ------------------------------------
# Hard ceiling on the years a posting may ask for. A role wanting 8 years is
# not one you get with 2-3, and ranking it low still left it in the list.
# JOB_MAX_YEARS=5                 # keep 0-5 year roles; 0 disables the filter.
#                                 # 5 is the REPO default, for forkers. Your own
#                                 # window belongs in profile.json as `max_years`
#                                 # (code default < profile < this env var).
# A posting that states NO bar always passes -- silence is not a requirement,
# and about half of all postings state nothing.
# JOB_EXCLUDE_LATE_STAGE=1        # opt in to dropping late-stage/public companies.
#                                 # OFF by default: it costs real roles, and the
#                                 # prose evidence is weak -- a seed startup that
#                                 # SELLS to Fortune 500s is not one.
# JOB_RELOCATION_FACTOR=0.55      # how much a role you'd have to move for is worth.
#                                 # Geography asks "could I do this from home?",
#                                 # not "which metro" -- an SF company hiring
#                                 # REMOTE ranks with NYC roles; SF on-site does not.
