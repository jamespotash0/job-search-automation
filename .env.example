# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is gitignored — your real values never get committed.
# For scheduled runs on GitHub Actions, add these same keys as repo secrets
# (Settings → Secrets and variables → Actions), not in this file.

# --- Email (required to receive digests) ---------------------------------
# Uses Gmail SMTP by default. EMAIL_PASS must be a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal login password. Enter it with no spaces (16 chars).
EMAIL_USER=you@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_TO=you@gmail.com          # where digests go; can equal EMAIL_USER, or a comma-separated list

# Digests arrive as "Job Bot (@Name)" so they don't look like mail from yourself.
# The handle defaults to the first name in EMAIL_USER; override it here.
# DIGEST_HANDLE=James

# Using a non-Gmail provider? Uncomment and set these:
# SMTP_HOST=smtp.office365.com   # e.g. Outlook
# SMTP_PORT=587

# --- AI summaries (optional) ---------------------------------------------
# From console.anthropic.com. Without it, the funding digest skips the
# AI company summaries; everything else still works. Costs a few cents/day.
ANTHROPIC_API_KEY=

# --- Verified founder emails (optional) ----------------------------------
# From hunter.io (free tier ~50/mo). Without it, contact emails are
# pattern-guessed and marked UNVERIFIED.
HUNTER_API_KEY=

# --- Hiring posts from X/Twitter (optional) ------------------------------
# From console.x.ai. Turns on the X/Grok source in the companies digest:
# founder "we're hiring" posts that never hit a job board. Uses xAI's Agent
# Tools API (x_search); ~half a cent per run, so cents/month. Either name works.
GROK_API_KEY=
# XAI_API_KEY=                    # alias — set one or the other, not both

# --- Extra job aggregator (optional) -------------------------------------
# Free app id + key from developer.adzuna.com. Broadens the companies digest
# beyond the ATS watchlist (indexes many boards + company career pages).
# Both must be set or the source stays off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Compiled profile for scheduled runs (GitHub Actions only) -----------
# NOT used locally (the scripts read profile.compiled.json from disk). For your
# fork's Actions runs, add the CONTENTS of your profile.compiled.json as the
# repo secret PROFILE_COMPILED_JSON, so the digests use your resume-tuned
# filters instead of the generic defaults. Regenerate with: python setup_profile.py
