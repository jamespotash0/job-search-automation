# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is gitignored — your real values never get committed.
# For scheduled runs on GitHub Actions, add these same keys as repo secrets
# (Settings → Secrets and variables → Actions), not in this file.

# --- Email (required to receive digests) ---------------------------------
# Uses Gmail SMTP by default. EMAIL_PASS must be a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal login password. Enter it with no spaces (16 chars).
EMAIL_USER=you@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_TO=you@gmail.com          # where digests go; can equal EMAIL_USER, or a comma-separated list

# Digests arrive as "Job Bot (@Name)" so they don't look like mail from yourself.
# The handle defaults to the first name in EMAIL_USER; override it here.
# DIGEST_HANDLE=James

# Using a non-Gmail provider? Uncomment and set these:
# SMTP_HOST=smtp.office365.com   # e.g. Outlook
# SMTP_PORT=587

# --- AI summaries (optional) ---------------------------------------------
# From console.anthropic.com. Without it, the funding digest skips the
# AI company summaries; everything else still works. Costs a few cents/day.
ANTHROPIC_API_KEY=

# --- Verified founder emails (optional) ----------------------------------
# From hunter.io (free tier ~50/mo). Without it, contact emails are
# pattern-guessed and marked UNVERIFIED.
HUNTER_API_KEY=
